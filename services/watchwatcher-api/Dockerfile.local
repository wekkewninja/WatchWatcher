FROM node:22.22.3-bookworm-slim AS build

WORKDIR /workspace
COPY package.json package-lock.json ./
COPY services/shared/package.json services/shared/package.json
COPY services/watchwatcher-api/package.json services/watchwatcher-api/package.json
COPY services/watchwatcher-web/package.json services/watchwatcher-web/package.json
RUN npm ci
COPY services/shared/ services/shared/
COPY services/watchwatcher-api/ services/watchwatcher-api/
RUN npm run build --workspace=services/watchwatcher-api

FROM build AS migrator
WORKDIR /workspace/services/watchwatcher-api
CMD ["npm", "run", "migrate"]

FROM build AS production-dependencies
RUN npm prune --omit=dev

FROM mcr.microsoft.com/azure-functions/node:4-node22 AS api
ENV AzureWebJobsScriptRoot=/home/site/wwwroot \
    AzureFunctionsJobHost__Logging__Console__IsEnabled=true
WORKDIR /home/site/wwwroot
COPY --from=build /workspace/services/watchwatcher-api/package.json ./package.json
COPY --from=build /workspace/services/watchwatcher-api/host.json ./host.json
COPY --from=build /workspace/services/watchwatcher-api/migrations ./migrations
COPY --from=build /workspace/services/watchwatcher-api/dist ./dist
COPY --from=production-dependencies /workspace/node_modules ./node_modules
EXPOSE 80
